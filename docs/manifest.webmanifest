{
  "name": "Share Video Embeds",
  "short_name": "Video Embeds",
  "id": "./youtube-to-x-player/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "theme_color": "#1758d6",
  "background_color": "#f3f7fc",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
